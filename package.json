{
	"name": "@turystack/nestjs-cache",
	"description": "Pluggable caching for NestJS with superjson serialization and method-level decorators.",
	"private": false,
	"version": "1.0.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src",
		"format": "biome format --write ./src",
		"lint": "biome lint ./src",
		"prepack": "pnpm run build",
		"services:down": "docker compose down -v",
		"services:up": "docker compose up -d --wait",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/turystack/nestjs-cache.git"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"@turystack/nestjs-config": "^1.0.0",
		"ioredis": "^5.0.0",
		"reflect-metadata": "^0.2.0",
		"superjson": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@turystack/nestjs-config": "^1.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"ioredis": "^5.0.0",
		"reflect-metadata": "^0.2.2",
		"superjson": "^2.0.0",
		"tsc-alias": "^1.9.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"zod": "^4.0.0"
	}
}
